NEXT_PUBLIC_SITE_URL=https://www.selenasystems.com

# Public contact links shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_TELEGRAM=
NEXT_PUBLIC_CONTACT_WHATSAPP=+7 921 933-11-13

# Lead delivery. Configure at least one delivery target in Vercel.
LEADS_TELEGRAM_BOT_TOKEN=
LEADS_TELEGRAM_CHAT_ID=
LEADS_WEBHOOK_URL=

# Visibility diagnostics — Supabase (Decision Log D-005, NEEDS_OWNER).
# Everything below is unset in every environment today; the mocked
# Phase 1 flow (lib/diagnostics/mockRun.ts) works without any of it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Signs the Phase 1 mock-run token (lib/diagnostics/mockRun.ts). Optional:
# falls back to a random per-process secret if unset, which just means
# tokens stop verifying across a redeploy — fine for the mock phase.
VISIBILITY_MOCK_SIGNING_SECRET=

# Visibility feature flags (SSOT §10.6, §27.7). All default OFF; set to
# "true" to enable. Live/paid ones (SE_RANKING, APIFY, SUBSCRIPTIONS,
# MONITOR, GSC/GA4_OAUTH) additionally require the matching Decision Log
# item (see docs/visibility/SELENA_VISIBILITY_DECISION_LOG.md) before
# they should ever be turned on outside local dev.
VISIBILITY_ENABLED=
VISIBILITY_FREE_CHECK_ENABLED=
VISIBILITY_EMAIL_UNLOCK_ENABLED=
VISIBILITY_LIVE_CRAWLER_ENABLED=
VISIBILITY_PAGESPEED_ENABLED=
VISIBILITY_AI_SAMPLE_ENABLED=
VISIBILITY_SE_RANKING_ENABLED=
VISIBILITY_APIFY_ENABLED=
VISIBILITY_GSC_OAUTH_ENABLED=
VISIBILITY_GA4_OAUTH_ENABLED=
VISIBILITY_SUBSCRIPTIONS_ENABLED=
VISIBILITY_MONITOR_ENABLED=
VISIBILITY_PUBLIC_REPORTS_ENABLED=
VISIBILITY_PROCESS_CHECK_ENABLED=
VISIBILITY_VILLA_REDIRECT_ENABLED=

# ── Video Research Radar (docs/video-radar.md) ────────────────────────────────
# Internal research tooling at /internal/video-radar. Everything below is unset
# in every environment today, and the Radar degrades to a documented empty state
# rather than failing when it is. Flags default OFF; set to "true" to enable.

# Master switch. While unset, every Radar route and page returns 404.
VIDEO_RADAR_ENABLED=

# Interim operator gate. There is no user authentication in this repository
# (see docs/video-radar-audit.md, risk R-1), so a long random shared secret is
# what stands between the public internet and internal research. Generate with
# `openssl rand -hex 32`. Server-side only — never exposed to the client.
VIDEO_RADAR_OPERATOR_TOKEN=

# Live YouTube discovery. Off (or with no API key) the Radar uses the fixture
# provider, which is an honest empty Radar rather than a crash.
VIDEO_RADAR_DISCOVERY_ENABLED=
YOUTUBE_API_KEY=

# Transcript retrieval. Off, every transcript reports `unsupported` and the
# Radar keeps working at metadata level.
VIDEO_RADAR_TRANSCRIPTS_ENABLED=

# Deep AI analysis. Off (or with no API key), metadata-level Radar still works
# and deep analysis is marked unavailable.
VIDEO_RADAR_ANALYSIS_ENABLED=
ANTHROPIC_API_KEY=

# Optional analysis tuning. Model defaults to claude-opus-5; effort is the main
# cost lever and defaults to "medium" (low | medium | high | xhigh | max).
VIDEO_RADAR_ANALYSIS_MODEL=
VIDEO_RADAR_ANALYSIS_EFFORT=
